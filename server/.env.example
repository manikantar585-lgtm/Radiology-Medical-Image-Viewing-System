# Copy this file to .env and fill in your own values. Never commit .env.

NODE_ENV=development
PORT=5000

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Microsoft SQL Server
DB_USER=your_sql_user
DB_PASSWORD=your_sql_password
DB_SERVER=localhost
DB_NAME=RadiologyDB
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# Create DB_NAME on startup if it does not exist (needs CREATE DATABASE rights).
DB_CREATE_IF_MISSING=false

# Secret used to sign login tokens. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Python AI service (ai-service/), started with:
#   uvicorn app:app --host 127.0.0.1 --port 8001
AI_SERVICE_URL=http://127.0.0.1:8001
