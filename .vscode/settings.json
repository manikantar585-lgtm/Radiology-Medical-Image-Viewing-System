{
    // Strict mode reports every untyped call into numpy / torch / pydicom
    // as an error. Standard still catches real bugs (undefined names,
    // wrong arguments, bad imports) without that noise.
    "python.analysis.typeCheckingMode": "standard",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "cSpell.words": [
        "bgcolor",
        "Manikanta",
        "Reddy",
        "NVARCHAR",
        "recordset",
        "NVarChar",
        "VarBinary",
        "analysed",
        "atelectasis",
        "exif",
        "fromarray",
        "hypermetabolic",
        "keepdim",
        "multimodal",
        "neuro",
        "pycache",
        "resamp",
        "resizer",
        "tobytes",
        "venv",
        "biomed",
        "biomedclip",
        "cardiomediastinum",
        "cardiomegaly",
        "cheville",
        "cornerstonejs",
        "craco",
        "dcmread",
        "densenet",
        "dicom",
        "dicomfile",
        "dicomweb",
        "fastapi",
        "fdata",
        "glioma",
        "gliomas",
        "Hounsfield",
        "hydronephrosis",
        "kidany",
        "libjpeg",
        "lymphadenopathy",
        "meningioma",
        "multilabel",
        "nibabel",
        "nifti",
        "nnunet",
        "numpy",
        "OHIF",
        "openjpeg",
        "opencv",
        "pathologies",
        "pubmedbert",
        "pydantic",
        "pydicom",
        "pylibjpeg",
        "radiograph",
        "radiographs",
        "Rediology",
        "resampled",
        "Segmentator",
        "SONOGRAPHY",
        "tharsana",
        "torchvision",
        "torchxrayvision",
        "totalsegmentator",
        "uvicorn",
        "voxel",
        "voxels",
        "wadors",
        "wadouri",
        "webimg",
        "xrv"
    ],
    "cSpell.ignorePaths": [
        "node_modules",
        "build",
        ".venv",
        "**/__pycache__/**",
        "package-lock.json"
    ],
    "python-envs.pythonProjects": [
        {
            "path": "ai-service",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:pip"
        }
    ]
}
